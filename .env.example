# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Endereço público do app (sem barra no final) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Gemini (Google AI Studio > Get API key) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Criptografia dos tokens (gere com: openssl rand -base64 32) ----
ENCRYPTION_KEY=

# ---- Gmail (Google Cloud > Credenciais > ID do cliente OAuth) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Outlook (Azure / Entra ID > Registros de aplicativo) ----
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Adzuna (developer.adzuna.com) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Busca dirigida na web (Google Custom Search JSON API), restrita a páginas de vaga de
# LinkedIn/Gupy/Catho/InfoJobs/Vagas.com/Indeed. Opcional: sem isso, essa fonte simplesmente
# não entra na busca. Gratuito até 100 buscas/dia; depois é pago (API do Google).
# 1. console.cloud.google.com -> crie/selecione um projeto -> ative "Custom Search API" -> crie uma chave (API key)
# 2. programmablesearchengine.google.com/controlpanel/create -> crie um mecanismo com "Search the entire web" -> copie o "Search engine ID" (cx)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ---- Segredo do disparo agendado (gere com: openssl rand -hex 24) ----
CRON_SECRET=

# ---- Limites ----
DAILY_GENERATION_LIMIT=30
DEFAULT_DAILY_SEND_LIMIT=20
